# Copy values into .local/runtime.env after running `osa init`.
# Keep actual secrets private. API and download secrets are generated by init.
OSA_MODEL=granite4:3b
OSA_OLLAMA_URL=http://127.0.0.1:11434
OSA_MODEL_TIMEOUT=600
OSA_PAYMENT_MODE=test
OSA_LIVE_PAYMENTS=false
OSA_PUBLIC_URL=http://127.0.0.1:8787
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Replace the generated local secret with the same secret configured in Razorpay.
RAZORPAY_WEBHOOK_SECRET=
BRAVE_API_KEY=
OSA_YOUTUBE_API_KEY=
OSA_IMAP_ENABLED=false
OSA_IMAP_AUTH=password
OSA_IMAP_HOST=
OSA_IMAP_PORT=993
OSA_IMAP_USER=
OSA_IMAP_PASSWORD=
OSA_IMAP_FOLDER=INBOX
OSA_ROUTE_ENABLED=false
OSA_LIVE_TRANSFERS=false
OSA_MAIL_ENABLED=false
OSA_MAIL_AUTH=password
# Personal Outlook uses microsoft auth, never a password. See docs/OUTLOOK.md.
OSA_MICROSOFT_CLIENT_ID=
OSA_SMTP_HOST=
OSA_SMTP_PORT=587
OSA_SMTP_USER=
OSA_SMTP_PASSWORD=
OSA_FROM_EMAIL=
OSA_MAIL_DAILY_LIMIT=10
